# macOS system files
.DS_Store
.AppleDouble
._*

# Model weights and checkpoints
*.bin
*.safetensors
*.gguf
checkpoints/
models/
outputs/
runs/

# Raw audio (never commit)
*.wav
*.mp3
*.flac
raw_audio/

# Environment and caches
.env
*.log
__pycache__/
*.pyc
venv/
.venv/

# Python build artifacts
build/
dist/
*.egg-info/
.pytest_cache/

# ========== Dataset: local temporary and backup files ==========
# Compressed archives kept locally only
*.zip
*.rar
*.7z
*.tar.gz
*.bz2

# Excel / CSV temporary files
~$*.xlsx
*.csv~
*.xls~

# Dataset intermediates, logs and backups
dataset/**/*.tmp
dataset/**/*.log
dataset/**/*.cache
dataset/**/*.bak

# System junk
.DS_Store
Thumbs.db
__pycache__
*.pyc
*.pyo

# Private field recordings (consent required, never public)
dataset/audio_raw/
*.wav
*.mp3
*.flac
*.m4a

# Scanned sources and images (not committed)
*.pdf
*.jpg
*.png
*.tiff

# Local-only dataset directories
dataset/raw_private/
dataset/raw_zenodo/.DS_Store

# Third-party data is not distributed: keep only notes and the fetch script,
# data is downloaded locally.
dataset/raw_zenodo/*
!dataset/raw_zenodo/README.md
!dataset/raw_zenodo/fetch_zenodo.py
!dataset/raw_zenodo/checksums.json
